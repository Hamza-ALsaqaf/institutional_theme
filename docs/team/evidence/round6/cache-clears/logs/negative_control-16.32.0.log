}\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n', 'footer': None}, 'Midad': {'header': '{#- Letter Head content (ADR 0005). Rendered by Frappe with Jinja at print time (printview.py:231-241).\n    `ins_identity()` returns strings only, possibly empty; every key is read with a default and escaped.\n    If the app is uninstalled and this record is kept, `ins_identity` is undefined (the `jinja` hook is gone):\n    the guard below makes it render nothing (no emblem either, whose file is gone) instead of failing the print.\n    A table, not flex: wkhtmltopdf has no flex. The emblem is the placeholder until Settings has one. -#}\n{%- set has_app = ins_identity is defined -%}\n{%- set ins = (ins_identity() if has_app else {}) or {} -%}\n{%- set arabic = (frappe.lang or "en")[:2] == "ar" -%}\n{%- set name_en = ins.get("institution_name", "") -%}\n{%- set name_ar = ins.get("institution_name_ar", "") -%}\n{%- set first = (name_ar or name_en) if arabic else (name_en or name_ar) -%}\n{%- set second = (name_en if first == name_ar else name_ar) if (name_en and name_ar) else "" -%}\n{%- if has_app or first or second -%}\n<table class="ins-lh" cellpadding="0" cellspacing="0">\n\t<tr>\n\t\t{%- if has_app %}\n\t\t<td class="ins-lh-emblem"><img src="{{ (ins.get(\'emblem_url\') or \'/assets/institutional_theme/images/ins_emblem_placeholder.svg\') | e }}" alt="" width="52" height="52"></td>\n\t\t<td class="ins-lh-gap"></td>\n\t\t{%- endif %}\n\t\t<td>\n\t\t\t{%- if first %}\n\t\t\t<div class="ins-lh-name">{{ first | e }}</div>\n\t\t\t{%- endif %}\n\t\t\t{%- if second %}\n\t\t\t<div class="ins-lh-name-second"{% if arabic %} dir="ltr"{% else %} dir="rtl"{% endif %}>{{ second | e }}</div>\n\t\t\t{%- endif %}\n\t\t\t{%- if ins.get("system_name") %}\n\t\t\t<div class="ins-lh-system">{{ ins.get("system_name") | e }}</div>\n\t\t\t{%- endif %}\n\t\t</td>\n\t</tr>\n</table>\n{%- endif %}\n', 'footer': '{#- Letter Head footer (ADR 0005). Same contract as letter_head.html. Page X of Y is added by core when the\n    Print Settings "repeat header and footer" option is on (standard.html), so it is not repeated here.\n    The guard on the first line keeps a kept record printable after the app is uninstalled. -#}\n{%- set ins = (ins_identity() if ins_identity is defined else {}) or {} -%}\n{%- set arabic = (frappe.lang or "en")[:2] == "ar" -%}\n{%- set name_en = ins.get("institution_name", "") -%}\n{%- set name_ar = ins.get("institution_name_ar", "") -%}\n{%- set name = (name_ar or name_en) if arabic else (name_en or name_ar) -%}\n{%- set line_one = [name, ins.get("system_name", "")] | select | join(" · ") -%}\n{%- set line_two = [ins.get("address", ""), ins.get("contact", "")] | select | join(" · ") -%}\n{%- if line_one or line_two %}\n<table class="ins-lf" cellpadding="0" cellspacing="0">\n\t<tr>\n\t\t<td>\n\t\t\t{%- if line_one %}<div>{{ line_one | e }}</div>{% endif %}\n\t\t\t{%- if line_two %}<div>{{ line_two | e }}</div>{% endif %}\n\t\t</td>\n\t</tr>\n</table>\n{%- endif %}\n'}}, 'active_domains': [''], 'all_domains': ['Manufacturing', 'Retail'], 'doctype_layouts': [], 'module_app': {'core': 'frappe', 'website': 'frappe', 'workflow': 'frappe', 'email': 'frappe', 'custom': 'frappe', 'geo': 'frappe', 'desk': 'frappe', 'integrations': 'frappe', 'printing': 'frappe', 'contacts': 'frappe', 'automation': 'frappe', 'hr': 'hrms', 'payroll': 'hrms', 'accounts': 'erpnext', 'crm': 'erpnext', 'buying': 'erpnext', 'projects': 'erpnext', 'selling': 'erpnext', 'setup': 'erpnext', 'manufacturing': 'erpnext', 'stock': 'erpnext', 'support': 'erpnext', 'utilities': 'erpnext', 'assets': 'erpnext', 'portal': 'erpnext', 'maintenance': 'erpnext', 'regional': 'erpnext', 'erpnext_integrations': 'erpnext', 'quality_management': 'erpnext', 'communication': 'erpnext', 'telephony': 'erpnext', 'bulk_transaction': 'erpnext', 'subcontracting': 'erpnext', 'edi': 'erpnext', 'institutional_theme': 'institutional_theme'}, 'single_types': ['Institutional Theme Settings', 'Security Settings'